<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Translate\Translate.csproj" />
    <ProjectReference Include="..\..\FanslationStudio.LlmKit\FanslationStudio.LlmKit\FanslationStudio.LlmKit.csproj" />
    <ProjectReference Include="..\..\FanslationStudio.LlmKit\FanslationStudio.LlmKit.Release\FanslationStudio.LlmKit.Release.csproj" />
    <ProjectReference Include="..\..\FanslationStudio.LlmKit\FanslationStudio.Installer.Core\FanslationStudio.Installer.Core.csproj" />
  </ItemGroup>

  <!-- The plugin's injection logic is plain C#; its sources are compiled in here so it can be tested without the game. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="..\PathOfKungfuPlugin\Translations.cs" Link="Plugin\Translations.cs" />
    <Compile Include="..\PathOfKungfuPlugin\JsonInjector.cs" Link="Plugin\JsonInjector.cs" />
    <Compile Include="..\PathOfKungfuPlugin\JsonFlattener.cs" Link="Plugin\JsonFlattener.cs" />
    <Compile Include="..\PathOfKungfuPlugin\SheetInjector.cs" Link="Plugin\SheetInjector.cs" />
    <Compile Include="..\PathOfKungfuPlugin\EnglishTokenBranch.cs" Link="Plugin\EnglishTokenBranch.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
